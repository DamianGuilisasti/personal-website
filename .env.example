# Copiá este archivo a .env (uso local) y/o cargá estas variables en:
# Vercel → tu proyecto → Settings → Environment Variables

# API key de Resend (resend.com → API Keys). Empieza con "re_"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# A dónde llegan los mensajes del formulario de contacto
CONTACT_TO_EMAIL=damianguilisasti@gmail.com

# Opcional: remitente que verás como "From". Si no verificás tu propio
# dominio en Resend, dejá el default de abajo (funciona sin configurar nada).
CONTACT_FROM_EMAIL=Damian Guilisasti Website <onboarding@resend.dev>
